rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Counter helpers
    function isValidCounter(data) {
      return data.count is int && 
             data.count >= 0 &&
             data.updatedAt is timestamp;
    }

    match /counters/diagnosis_completions {
      allow read: if true;
      allow update, create: if isValidCounter(request.resource.data) &&
                           request.resource.data.updatedAt == request.time;
    }

    match /counters/total_visitors {
      allow read: if true;
      allow update, create: if isValidCounter(request.resource.data) &&
                           request.resource.data.updatedAt == request.time;
    }
  }
}
